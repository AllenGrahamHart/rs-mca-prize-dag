  {
   "id": "L4",
   "law": "common-latent cross-junction nullity is identically zero",
   "status": "SURVIVES",
   "evidence": "8 rows: sum_j rank_x(block j) = global rank = t in every case (the t Vandermonde rows split into blocks by v_2(r), and any t rows of a Vandermonde with distinct nodes are independent); violations = 0"
  },
  {
   "id": "L11",
   "law": "a cross-junction circuit (the trap geometry) is realizable in the DLI tower",
   "status": "DIES",
   "evidence": "no support of any junction has a rank defect (L1) and the block row spaces are independent (L4); a 33-junction system with local ranks summing above the global rank -- the four-wise / 32-wise trap -- therefore has no DLI realization at tower-junction granularity"
  },
  {
   "id": "L5",
   "law": "exact identity R = E_MF[q^delta]",
   "status": "DIES",
   "evidence": "fails at 18/18 rows (equality holds nowhere)"
  },
